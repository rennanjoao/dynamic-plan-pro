# ─── Variáveis de Ambiente — Elite Prime Hub ───────────────────────────────
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env no git — ele já está no .gitignore.
# ──────────────────────────────────────────────────────────────────────────

# Supabase — chaves públicas (safe para expor no frontend)
VITE_SUPABASE_PROJECT_ID="seu-project-id-aqui"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
VITE_SUPABASE_URL="https://seu-project-id.supabase.co"

# ─── Variáveis de servidor (Edge Functions) ────────────────────────────────
# Configuradas no painel do Supabase → Project Settings → Edge Functions → Secrets
# NUNCA colocar aqui — só documentar os nomes:
#   SUPABASE_SERVICE_ROLE_KEY  — chave de serviço (acesso total ao banco, ignorando RLS)
#   RESEND_API_KEY             — chave da API Resend para envio de e-mails
#   GEMINI_API_KEY             — chave da API Google Gemini para o assistente de IA
